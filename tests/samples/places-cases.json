{
  "version": 1,
  "about": "t-083: the shared cases of worker places and the start order. Read by tests/test_pa_places.py (runtime/tools/pa_places.py) and by the store harness (mods/project-agent/places.js), so both implementations agree. Codes and numbers only; each side words its own lines. jobs are in the Project Agent's order (waiting.json); a job given as a string is {id, kind: working, source: pa, blockedBy: null}. holders are the recorded place of each live unfinished worker (null: not recorded, counted as working). hold: off | on | unknown | no-terminals.",
  "orderCases": [
    {"name": "AC8.1 ordered movable jobs fill the movable slots, the queue job keeps its index",
     "jobs": ["A", {"id": "Q1", "source": "queue"}, "B", "C"],
     "orderText": "{\"version\": 1, \"order\": [\"C\", \"A\"]}",
     "effective": ["C", "Q1", "A", "B"], "error": null},
    {"name": "no order file: the Project Agent's order (D2)",
     "jobs": ["A", "B"], "orderText": null, "effective": ["A", "B"], "error": "missing"},
    {"name": "ids no longer waiting are ignored",
     "jobs": ["A", "B", "C"], "orderText": "{\"version\": 1, \"order\": [\"gone\", \"C\", \"also-gone\"]}",
     "effective": ["C", "A", "B"], "error": null},
    {"name": "a queue job named in the order stays at its index",
     "jobs": [{"id": "Q1", "source": "queue"}, "A", "B"], "orderText": "{\"version\": 1, \"order\": [\"B\", \"Q1\", \"A\"]}",
     "effective": ["Q1", "B", "A"], "error": null},
    {"name": "an id named twice counts once, at its first place",
     "jobs": ["A", "B", "C"], "orderText": "{\"version\": 1, \"order\": [\"B\", \"A\", \"B\"]}",
     "effective": ["B", "A", "C"], "error": null},
    {"name": "new jobs not in the order follow the ordered ones, in the Project Agent's order",
     "jobs": ["N1", "A", "N2", {"id": "Q1", "source": "queue"}, "B"], "orderText": "{\"version\": 1, \"order\": [\"B\", \"A\"]}",
     "effective": ["B", "A", "N1", "Q1", "N2"], "error": null},
    {"name": "an empty order list is valid: the Project Agent's order",
     "jobs": ["A", "B"], "orderText": "{\"version\": 1, \"order\": []}", "effective": ["A", "B"], "error": null},
    {"name": "AC8.2 empty file", "jobs": ["A", "B"], "orderText": "", "effective": ["A", "B"], "error": "empty"},
    {"name": "AC8.2 blank file", "jobs": ["A", "B"], "orderText": "  \n", "effective": ["A", "B"], "error": "empty"},
    {"name": "AC8.2 not JSON", "jobs": ["A", "B"], "orderText": "{\"version\": 1, \"order\": [\"B\"", "effective": ["A", "B"], "error": "not-json"},
    {"name": "AC8.2 not an object", "jobs": ["A", "B"], "orderText": "[\"B\", \"A\"]", "effective": ["A", "B"], "error": "not-object"},
    {"name": "AC8.2 wrong version", "jobs": ["A", "B"], "orderText": "{\"version\": 2, \"order\": [\"B\"]}", "effective": ["A", "B"], "error": "version"},
    {"name": "AC8.2 no version", "jobs": ["A", "B"], "orderText": "{\"order\": [\"B\"]}", "effective": ["A", "B"], "error": "version"},
    {"name": "AC8.2 order not a list", "jobs": ["A", "B"], "orderText": "{\"version\": 1, \"order\": \"B\"}", "effective": ["A", "B"], "error": "order"},
    {"name": "AC8.2 order not a list of strings", "jobs": ["A", "B"], "orderText": "{\"version\": 1, \"order\": [\"B\", 3]}", "effective": ["A", "B"], "error": "order"},
    {"name": "AC8.2 no order", "jobs": ["A", "B"], "orderText": "{\"version\": 1}", "effective": ["A", "B"], "error": "order"}
  ],
  "limitCases": [
    {"name": "AC2.4 no rule names a kind: the defaults",
     "rules": {"rules": [{"id": "r-a", "text": "x", "status": "active", "order": 10}]},
     "limits": {"working": 4, "no-test": 0, "suite": null},
     "sources": {"working": "default", "no-test": "default", "suite": "default"}, "notes": []},
    {"name": "the space's rule",
     "rules": {"rules": [{"id": "r-places", "text": "x", "status": "active", "order": 50, "places": {"working": 4, "no-test": 1, "suite": 2}}]},
     "limits": {"working": 4, "no-test": 1, "suite": 2},
     "sources": {"working": "r-places", "no-test": "r-places", "suite": "r-places"}, "notes": []},
    {"name": "AC2.1 the active rule with the highest order that names the kind wins, per kind",
     "rules": {"rules": [{"id": "r-low", "text": "x", "status": "active", "order": 20, "places": {"working": 5, "suite": 1}},
                         {"id": "r-high", "text": "x", "status": "active", "order": 30, "places": {"working": 3}}]},
     "limits": {"working": 3, "no-test": 0, "suite": 1},
     "sources": {"working": "r-high", "no-test": "default", "suite": "r-low"}, "notes": []},
    {"name": "AC2.2 off, proposed and declined rules are ignored",
     "rules": {"rules": [{"id": "r-off", "text": "x", "status": "off", "order": 90, "places": {"working": 1}},
                         {"id": "r-prop", "text": "x", "status": "proposed", "order": 80, "places": {"working": 2}},
                         {"id": "r-no", "text": "x", "status": "declined", "order": 70, "places": {"no-test": 3, "gpu": 1}},
                         {"id": "r-on", "text": "x", "status": "active", "order": 10, "places": {"working": 6}}]},
     "limits": {"working": 6, "no-test": 0, "suite": null},
     "sources": {"working": "r-on", "no-test": "default", "suite": "default"}, "notes": []},
    {"name": "AC2.3 bad values and unknown kinds are ignored and named once; a lower rule's good value is used",
     "rules": {"rules": [{"id": "r-x", "text": "x", "status": "active", "order": 40, "places": {"gpu": 2, "working": -1, "suite": 1.5, "no-test": true}},
                         {"id": "r-y", "text": "x", "status": "active", "order": 30, "places": {"working": "4"}},
                         {"id": "r-z", "text": "x", "status": "active", "order": 20, "places": {"working": 2, "suite": 0}}]},
     "limits": {"working": 2, "no-test": 0, "suite": 0},
     "sources": {"working": "r-z", "no-test": "default", "suite": "r-z"},
     "notes": ["r-x: places.gpu is not a known kind; ignored",
               "r-x: places.working is not a whole number >= 0; ignored",
               "r-x: places.suite is not a whole number >= 0; ignored",
               "r-x: places.no-test is not a whole number >= 0; ignored",
               "r-y: places.working is not a whole number >= 0; ignored"]},
    {"name": "AC2.3 places not an object",
     "rules": {"rules": [{"id": "r-x", "text": "x", "status": "active", "order": 40, "places": [4]}]},
     "limits": {"working": 4, "no-test": 0, "suite": null},
     "sources": {"working": "default", "no-test": "default", "suite": "default"},
     "notes": ["r-x: places is not an object; ignored"]},
    {"name": "a rule with no order counts as order 0",
     "rules": {"rules": [{"id": "r-none", "text": "x", "status": "active", "places": {"working": 9}},
                         {"id": "r-one", "text": "x", "status": "active", "order": 1, "places": {"working": 7}}]},
     "limits": {"working": 7, "no-test": 0, "suite": null},
     "sources": {"working": "r-one", "no-test": "default", "suite": "default"}, "notes": []},
    {"name": "no rules list: the defaults",
     "rules": {}, "limits": {"working": 4, "no-test": 0, "suite": null},
     "sources": {"working": "default", "no-test": "default", "suite": "default"}, "notes": []}
  ],
  "allocCases": [
    {"name": "AC7.1 suite full: both suite jobs skipped, the working job below them starts",
     "jobs": [{"id": "A", "kind": "suite"}, {"id": "B", "kind": "suite"}, {"id": "C", "kind": "working"}],
     "limits": {"working": 4, "no-test": 0, "suite": 2}, "holders": ["suite", "suite"], "hold": "off",
     "expect": [{"id": "A", "action": "skip", "place": null, "full": {"kind": "suite", "used": 2, "limit": 2}},
                {"id": "B", "action": "skip", "place": null, "full": {"kind": "suite", "used": 2, "limit": 2}},
                {"id": "C", "action": "start", "place": "working", "full": null}]},
    {"name": "AC7.2 the working job takes the last working place, the no-test job the extra one",
     "jobs": [{"id": "A", "kind": "working"}, {"id": "B", "kind": "no-test"}],
     "limits": {"working": 4, "no-test": 1, "suite": 2}, "holders": ["working", "working", "suite"], "hold": "off",
     "expect": [{"id": "A", "action": "start", "place": "working", "full": null},
                {"id": "B", "action": "start", "place": "no-test", "full": null}]},
    {"name": "AC7.3 a blocked job is skipped whatever its place",
     "jobs": [{"id": "A", "kind": "working", "blockedBy": "waits for d-1"}, {"id": "B", "kind": "working"}],
     "limits": {"working": 4, "no-test": 0, "suite": null}, "holders": [], "hold": "off",
     "expect": [{"id": "A", "action": "blocked", "place": null, "full": null},
                {"id": "B", "action": "start", "place": "working", "full": null}]},
    {"name": "AC7.4 hold on: none starts",
     "jobs": [{"id": "A", "kind": "working"}, {"id": "B", "kind": "no-test"}],
     "limits": {"working": 4, "no-test": 1, "suite": null}, "holders": [], "hold": "on",
     "expect": [{"id": "A", "action": "hold", "place": null, "full": null},
                {"id": "B", "action": "hold", "place": null, "full": null}]},
    {"name": "AC7.4 hold unknown: none starts",
     "jobs": [{"id": "A", "kind": "working"}],
     "limits": {"working": 4, "no-test": 0, "suite": null}, "holders": [], "hold": "unknown",
     "expect": [{"id": "A", "action": "hold", "place": null, "full": null}]},
    {"name": "terminal list unavailable: none starts",
     "jobs": [{"id": "A", "kind": "working"}],
     "limits": {"working": 4, "no-test": 0, "suite": null}, "holders": [], "hold": "no-terminals",
     "expect": [{"id": "A", "action": "hold", "place": null, "full": null}]},
    {"name": "a started job counts for the ones after it",
     "jobs": [{"id": "A", "kind": "working"}, {"id": "B", "kind": "suite"}, {"id": "C", "kind": "working"}],
     "limits": {"working": 3, "no-test": 0, "suite": 2}, "holders": ["working"], "hold": "off",
     "expect": [{"id": "A", "action": "start", "place": "working", "full": null},
                {"id": "B", "action": "start", "place": "suite", "full": null},
                {"id": "C", "action": "skip", "place": null, "full": {"kind": "working", "used": 3, "limit": 3}}]},
    {"name": "the mockup: working and suite full, the no-test job third in the order starts",
     "jobs": [{"id": "t-020/verify-2", "kind": "suite"}, {"id": "t-060/merge-check", "kind": "suite", "source": "queue"},
              {"id": "t-083/design", "kind": "no-test"}],
     "limits": {"working": 4, "no-test": 1, "suite": 2}, "holders": ["working", "suite", "suite", "working"], "hold": "off",
     "expect": [{"id": "t-020/verify-2", "action": "skip", "place": null, "full": {"kind": "suite", "used": 2, "limit": 2}},
                {"id": "t-060/merge-check", "action": "skip", "place": null, "full": {"kind": "suite", "used": 2, "limit": 2}},
                {"id": "t-083/design", "action": "start", "place": "no-test", "full": null}]},
    {"name": "a no-test job takes a working place while one is free",
     "jobs": [{"id": "A", "kind": "no-test"}, {"id": "B", "kind": "working"}],
     "limits": {"working": 2, "no-test": 1, "suite": null}, "holders": [], "hold": "off",
     "expect": [{"id": "A", "action": "start", "place": "working", "full": null},
                {"id": "B", "action": "start", "place": "working", "full": null}]},
    {"name": "D3 pooled: a no-test holder in a working place leaves room for a working job while the extra is free",
     "jobs": [{"id": "A", "kind": "working"}, {"id": "B", "kind": "no-test"}],
     "limits": {"working": 2, "no-test": 1, "suite": null}, "holders": ["working", "no-test"], "hold": "off",
     "expect": [{"id": "A", "action": "start", "place": "working", "full": null},
                {"id": "B", "action": "skip", "place": null, "full": {"kind": "no-test", "used": 1, "limit": 1}}]},
    {"name": "no extra place (no-test 0): a no-test job waits on working",
     "jobs": [{"id": "A", "kind": "no-test"}],
     "limits": {"working": 2, "no-test": 0, "suite": null}, "holders": ["working", "working"], "hold": "off",
     "expect": [{"id": "A", "action": "skip", "place": null, "full": {"kind": "working", "used": 2, "limit": 2}}]},
    {"name": "a worker with no recorded place counts as working",
     "jobs": [{"id": "A", "kind": "working"}],
     "limits": {"working": 2, "no-test": 1, "suite": null}, "holders": [null, "working"], "hold": "off",
     "expect": [{"id": "A", "action": "skip", "place": null, "full": {"kind": "working", "used": 2, "limit": 2}}]},
    {"name": "no suite cap: a suite job needs only a working place",
     "jobs": [{"id": "A", "kind": "suite"}, {"id": "B", "kind": "suite"}],
     "limits": {"working": 4, "no-test": 0, "suite": null}, "holders": ["suite", "suite", "suite"], "hold": "off",
     "expect": [{"id": "A", "action": "start", "place": "suite", "full": null},
                {"id": "B", "action": "skip", "place": null, "full": {"kind": "working", "used": 4, "limit": 4}}]},
    {"name": "over the limit (lowered while workers run): skipped, the count shown as it is",
     "jobs": [{"id": "A", "kind": "working"}],
     "limits": {"working": 2, "no-test": 0, "suite": null}, "holders": ["working", "working", "working"], "hold": "off",
     "expect": [{"id": "A", "action": "skip", "place": null, "full": {"kind": "working", "used": 3, "limit": 2}}]},
    {"name": "both full for a suite job: the suite cap is named",
     "jobs": [{"id": "A", "kind": "suite"}],
     "limits": {"working": 2, "no-test": 0, "suite": 2}, "holders": ["suite", "suite"], "hold": "off",
     "expect": [{"id": "A", "action": "skip", "place": null, "full": {"kind": "suite", "used": 2, "limit": 2}}]},
    {"name": "pooled total: a no-test holder in a working place fills the pool for a working job (default limits)",
     "jobs": [{"id": "A", "kind": "working"}],
     "limits": {"working": 4, "no-test": 0, "suite": null}, "holders": ["working", "working", "working", "no-test"], "hold": "off",
     "expect": [{"id": "A", "action": "skip", "place": null, "full": {"kind": "working", "used": 4, "limit": 4}}]},
    {"name": "pooled total: working and extra places all taken, a working job is skipped",
     "jobs": [{"id": "A", "kind": "working"}],
     "limits": {"working": 4, "no-test": 1, "suite": null}, "holders": ["working", "working", "working", "no-test", "no-test"], "hold": "off",
     "expect": [{"id": "A", "action": "skip", "place": null, "full": {"kind": "working", "used": 4, "limit": 4}}]},
    {"name": "pooled total: no-test jobs started first take working places from the working jobs after them",
     "jobs": [{"id": "N1", "kind": "no-test"}, {"id": "N2", "kind": "no-test"}, "A", "B", "C"],
     "limits": {"working": 4, "no-test": 0, "suite": null}, "holders": [], "hold": "off",
     "expect": [{"id": "N1", "action": "start", "place": "working", "full": null},
                {"id": "N2", "action": "start", "place": "working", "full": null},
                {"id": "A", "action": "start", "place": "working", "full": null},
                {"id": "B", "action": "start", "place": "working", "full": null},
                {"id": "C", "action": "skip", "place": null, "full": {"kind": "working", "used": 4, "limit": 4}}]},
    {"name": "pooled total: a suite job under its cap is skipped when the pool is full, working named",
     "jobs": [{"id": "A", "kind": "suite"}],
     "limits": {"working": 4, "no-test": 0, "suite": 2}, "holders": ["working", "working", "working", "no-test"], "hold": "off",
     "expect": [{"id": "A", "action": "skip", "place": null, "full": {"kind": "working", "used": 4, "limit": 4}}]}
  ]
}
