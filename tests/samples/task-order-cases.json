{
  "version": 1,
  "about": "t-097: the shared cases of the person's task order. Read by tests/test_pa_places.py (runtime/tools/pa_places.py) and by the panel's harnesses (J2), so both implementations agree. readCases: task-order.json's text (null: no file) -> error code, the line both sides say (null when readable: each side words its own 'yours' / 'the person's'), and what is read. rankCases: the ledger's tasks, its taskOrder and the file's text -> the effective ranking, top first, as [id, source]. moveCases: a ranking ([id, state, source], top first), the readable file's order and last, a section, a task and a move -> the new {order, last}, or null for a no-op (nothing written).",
  "readCases": [
    {"name": "no file", "text": null, "error": "missing", "line": "order: the Project Agent's",
     "order": [], "last": [], "updated": null},
    {"name": "valid", "text": "{\"version\": 1, \"updated\": \"2026-11-19T10:00:00Z\", \"by\": \"person\", \"order\": [\"t-2\", \"t-1\"], \"last\": [\"t-3\"], \"moves\": []}",
     "error": null, "line": null, "order": ["t-2", "t-1"], "last": ["t-3"], "updated": "2026-11-19T10:00:00Z"},
    {"name": "no last: an empty last", "text": "{\"version\": 1, \"updated\": \"U1\", \"order\": [\"t-1\"]}",
     "error": null, "line": null, "order": ["t-1"], "last": [], "updated": "U1"},
    {"name": "updated not a string: read as null", "text": "{\"version\": 1, \"updated\": 5, \"order\": [], \"last\": []}",
     "error": null, "line": null, "order": [], "last": [], "updated": null},
    {"name": "empty file", "text": "", "error": "empty",
     "line": "task order unreadable: task-order.json is empty; the Project Agent's order is used", "order": [], "last": [], "updated": null},
    {"name": "blank file", "text": " \n", "error": "empty",
     "line": "task order unreadable: task-order.json is empty; the Project Agent's order is used", "order": [], "last": [], "updated": null},
    {"name": "not JSON", "text": "{\"version\": 1, \"order\": [\"t-1\"", "error": "not-json",
     "line": "task order unreadable: task-order.json is not JSON; the Project Agent's order is used", "order": [], "last": [], "updated": null},
    {"name": "not an object", "text": "[\"t-1\"]", "error": "not-object",
     "line": "task order unreadable: task-order.json is not a JSON object; the Project Agent's order is used", "order": [], "last": [], "updated": null},
    {"name": "version 2", "text": "{\"version\": 2, \"order\": [\"t-1\"], \"last\": []}", "error": "version",
     "line": "task order unreadable: task-order.json is not version 1; the Project Agent's order is used", "order": [], "last": [], "updated": null},
    {"name": "version true", "text": "{\"version\": true, \"order\": [\"t-1\"], \"last\": []}", "error": "version",
     "line": "task order unreadable: task-order.json is not version 1; the Project Agent's order is used", "order": [], "last": [], "updated": null},
    {"name": "no version", "text": "{\"order\": [\"t-1\"], \"last\": []}", "error": "version",
     "line": "task order unreadable: task-order.json is not version 1; the Project Agent's order is used", "order": [], "last": [], "updated": null},
    {"name": "order not a list", "text": "{\"version\": 1, \"order\": \"t-1\", \"last\": []}", "error": "order",
     "line": "task order unreadable: task-order.json's order is not a list of task ids; the Project Agent's order is used", "order": [], "last": [], "updated": null},
    {"name": "order not a list of strings", "text": "{\"version\": 1, \"order\": [\"t-1\", 2], \"last\": []}", "error": "order",
     "line": "task order unreadable: task-order.json's order is not a list of task ids; the Project Agent's order is used", "order": [], "last": [], "updated": null},
    {"name": "no order", "text": "{\"version\": 1, \"last\": []}", "error": "order",
     "line": "task order unreadable: task-order.json's order is not a list of task ids; the Project Agent's order is used", "order": [], "last": [], "updated": null},
    {"name": "last not a list", "text": "{\"version\": 1, \"order\": [], \"last\": \"t-1\"}", "error": "last",
     "line": "task order unreadable: task-order.json's last is not a list of task ids; the Project Agent's order is used", "order": [], "last": [], "updated": null},
    {"name": "last not a list of strings", "text": "{\"version\": 1, \"order\": [], \"last\": [null]}", "error": "last",
     "line": "task order unreadable: task-order.json's last is not a list of task ids; the Project Agent's order is used", "order": [], "last": [], "updated": null}
  ],
  "rankCases": [
    {"name": "R27 no file and no taskOrder: created order; done and other states are not ranked; needs-decision and parked are",
     "tasks": [{"id": "t-3", "state": "queued", "created": "2026-11-03T00:00:00Z"},
               {"id": "t-1", "state": "in-progress", "created": "2026-11-01T00:00:00Z"},
               {"id": "t-2", "state": "review", "created": "2026-11-02T00:00:00Z"},
               {"id": "t-4", "state": "done", "created": "2026-10-01T00:00:00Z"},
               {"id": "t-5", "state": "needs-decision", "created": "2026-11-05T00:00:00Z"},
               {"id": "t-6", "state": "parked", "created": "2026-11-04T00:00:00Z"},
               {"id": "t-7", "state": "investigating", "created": "2026-11-06T00:00:00Z"},
               {"id": "t-8", "state": "unknown-state", "created": "2026-09-01T00:00:00Z"}],
     "taskOrder": null, "fileText": null, "error": "missing",
     "expect": [["t-1", "agent"], ["t-2", "agent"], ["t-3", "agent"], ["t-6", "agent"], ["t-5", "agent"], ["t-7", "agent"]]},
    {"name": "same created: id by number; tasks with no created after the dated ones",
     "tasks": [{"id": "t-10", "state": "queued"}, {"id": "t-9", "state": "queued"},
               {"id": "t-100", "state": "queued", "created": "2026-11-02T00:00:00Z"},
               {"id": "t-2", "state": "queued", "created": "2026-11-02T00:00:00Z"}],
     "taskOrder": null, "fileText": null, "error": "missing",
     "expect": [["t-2", "agent"], ["t-100", "agent"], ["t-9", "agent"], ["t-10", "agent"]]},
    {"name": "the file's order, then the Project Agent's, then the file's last",
     "tasks": [{"id": "t-1", "state": "queued", "created": "2026-11-01T00:00:00Z"}, {"id": "t-2", "state": "queued", "created": "2026-11-02T00:00:00Z"},
               {"id": "t-3", "state": "queued", "created": "2026-11-03T00:00:00Z"}, {"id": "t-4", "state": "queued", "created": "2026-11-04T00:00:00Z"},
               {"id": "t-5", "state": "queued", "created": "2026-11-05T00:00:00Z"}],
     "taskOrder": null, "fileText": "{\"version\": 1, \"updated\": \"U1\", \"order\": [\"t-4\", \"t-2\"], \"last\": [\"t-1\"]}", "error": null,
     "expect": [["t-4", "person"], ["t-2", "person"], ["t-3", "agent"], ["t-5", "agent"], ["t-1", "person"]]},
    {"name": "a duplicate counts at its first place; an id in both order and last counts in order",
     "tasks": [{"id": "t-1", "state": "queued", "created": "2026-11-01T00:00:00Z"}, {"id": "t-2", "state": "queued", "created": "2026-11-02T00:00:00Z"},
               {"id": "t-3", "state": "queued", "created": "2026-11-03T00:00:00Z"}, {"id": "t-4", "state": "queued", "created": "2026-11-04T00:00:00Z"}],
     "taskOrder": null, "fileText": "{\"version\": 1, \"updated\": \"U1\", \"order\": [\"t-3\", \"t-1\", \"t-3\"], \"last\": [\"t-1\", \"t-2\", \"t-2\"]}", "error": null,
     "expect": [["t-3", "person"], ["t-1", "person"], ["t-4", "agent"], ["t-2", "person"]]},
    {"name": "ids not in the ledger and done ids in the file are skipped",
     "tasks": [{"id": "t-1", "state": "queued", "created": "2026-11-01T00:00:00Z"}, {"id": "t-2", "state": "done", "created": "2026-11-02T00:00:00Z"},
               {"id": "t-3", "state": "queued", "created": "2026-11-03T00:00:00Z"}],
     "taskOrder": null, "fileText": "{\"version\": 1, \"updated\": \"U1\", \"order\": [\"gone\", \"t-2\", \"t-3\"], \"last\": [\"t-2\"]}", "error": null,
     "expect": [["t-3", "person"], ["t-1", "agent"]]},
    {"name": "R12 taskOrder.order first, then created; a new task at its end lands above the file's last",
     "tasks": [{"id": "t-1", "state": "queued", "created": "2026-11-01T00:00:00Z"}, {"id": "t-2", "state": "queued", "created": "2026-11-02T00:00:00Z"},
               {"id": "t-3", "state": "queued", "created": "2026-11-03T00:00:00Z"}, {"id": "t-4", "state": "queued", "created": "2026-11-04T00:00:00Z"},
               {"id": "t-5", "state": "queued", "created": "2026-11-05T00:00:00Z"}],
     "taskOrder": {"order": ["t-3", "t-1", "gone", "t-5"], "chat": []},
     "fileText": "{\"version\": 1, \"updated\": \"U1\", \"order\": [], \"last\": [\"t-2\"]}", "error": null,
     "expect": [["t-3", "agent"], ["t-1", "agent"], ["t-5", "agent"], ["t-4", "agent"], ["t-2", "person"]]},
    {"name": "R12 a chat entry applies while the file's updated equals its over",
     "tasks": [{"id": "t-1", "state": "queued", "created": "2026-11-01T00:00:00Z"}, {"id": "t-2", "state": "queued", "created": "2026-11-02T00:00:00Z"},
               {"id": "t-3", "state": "queued", "created": "2026-11-03T00:00:00Z"}],
     "taskOrder": {"order": [], "chat": [{"task": "t-3", "quote": "do t-3 now", "over": "U1"}]},
     "fileText": "{\"version\": 1, \"updated\": \"U1\", \"order\": [\"t-1\"], \"last\": []}", "error": null,
     "expect": [["t-3", "chat"], ["t-1", "person"], ["t-2", "agent"]]},
    {"name": "R12 a chat entry over an older file stops applying",
     "tasks": [{"id": "t-1", "state": "queued", "created": "2026-11-01T00:00:00Z"}, {"id": "t-2", "state": "queued", "created": "2026-11-02T00:00:00Z"},
               {"id": "t-3", "state": "queued", "created": "2026-11-03T00:00:00Z"}],
     "taskOrder": {"order": [], "chat": [{"task": "t-3", "quote": "do t-3 now", "over": "U0"}]},
     "fileText": "{\"version\": 1, \"updated\": \"U1\", \"order\": [\"t-1\"], \"last\": []}", "error": null,
     "expect": [["t-1", "person"], ["t-2", "agent"], ["t-3", "agent"]]},
    {"name": "R12 a chat entry over no file (null) applies while there is no file",
     "tasks": [{"id": "t-1", "state": "queued", "created": "2026-11-01T00:00:00Z"}, {"id": "t-2", "state": "queued", "created": "2026-11-02T00:00:00Z"},
               {"id": "t-3", "state": "queued", "created": "2026-11-03T00:00:00Z"}],
     "taskOrder": {"order": [], "chat": [{"task": "t-2", "quote": "hotfix t-2", "over": null}]}, "fileText": null, "error": "missing",
     "expect": [["t-2", "chat"], ["t-1", "agent"], ["t-3", "agent"]]},
    {"name": "R12 a chat entry over no file stops applying once the file exists",
     "tasks": [{"id": "t-1", "state": "queued", "created": "2026-11-01T00:00:00Z"}, {"id": "t-2", "state": "queued", "created": "2026-11-02T00:00:00Z"},
               {"id": "t-3", "state": "queued", "created": "2026-11-03T00:00:00Z"}],
     "taskOrder": {"order": [], "chat": [{"task": "t-2", "quote": "hotfix t-2", "over": null}]},
     "fileText": "{\"version\": 1, \"updated\": \"U1\", \"order\": [], \"last\": []}", "error": null,
     "expect": [["t-1", "agent"], ["t-2", "agent"], ["t-3", "agent"]]},
    {"name": "J1-D2 an unreadable file counts as no file: nothing of it is used, a chat entry over null applies",
     "tasks": [{"id": "t-1", "state": "queued", "created": "2026-11-01T00:00:00Z"}, {"id": "t-2", "state": "queued", "created": "2026-11-02T00:00:00Z"},
               {"id": "t-3", "state": "queued", "created": "2026-11-03T00:00:00Z"}],
     "taskOrder": {"order": [], "chat": [{"task": "t-2", "quote": "hotfix t-2", "over": null}]},
     "fileText": "{\"version\": 1, \"updated\": \"U1\", \"order\": [\"t-3\"], \"last\": [7]}", "error": "last",
     "expect": [["t-2", "chat"], ["t-1", "agent"], ["t-3", "agent"]]},
    {"name": "chat entries keep their listed order; a done task's entry and bad entries are skipped",
     "tasks": [{"id": "t-1", "state": "queued", "created": "2026-11-01T00:00:00Z"}, {"id": "t-2", "state": "done", "created": "2026-11-02T00:00:00Z"},
               {"id": "t-3", "state": "queued", "created": "2026-11-03T00:00:00Z"}, {"id": "t-4", "state": "queued", "created": "2026-11-04T00:00:00Z"}],
     "taskOrder": {"order": [], "chat": [{"task": "t-4", "quote": "a", "over": null}, {"task": "t-2", "quote": "b", "over": null}, "t-1",
                                         {"quote": "no task", "over": null}, {"task": "t-3", "quote": "c", "over": null}, {"task": "t-4", "quote": "again", "over": null}]},
     "fileText": null, "error": "missing",
     "expect": [["t-4", "chat"], ["t-3", "chat"], ["t-1", "agent"]]},
    {"name": "a taskOrder not of its shape counts as empty",
     "tasks": [{"id": "t-1", "state": "queued", "created": "2026-11-01T00:00:00Z"}, {"id": "t-2", "state": "queued", "created": "2026-11-02T00:00:00Z"}],
     "taskOrder": {"order": "t-2", "chat": 3}, "fileText": null, "error": "missing",
     "expect": [["t-1", "agent"], ["t-2", "agent"]]},
    {"name": "R5 needs-decision and parked tasks keep the place the file gives them",
     "tasks": [{"id": "t-1", "state": "queued", "created": "2026-11-01T00:00:00Z"}, {"id": "t-2", "state": "parked", "created": "2026-11-02T00:00:00Z"},
               {"id": "t-3", "state": "needs-decision", "created": "2026-11-03T00:00:00Z"}],
     "taskOrder": null, "fileText": "{\"version\": 1, \"updated\": \"U1\", \"order\": [\"t-3\", \"t-2\"], \"last\": []}", "error": null,
     "expect": [["t-3", "person"], ["t-2", "person"], ["t-1", "agent"]]}
  ],
  "moveCases": [
    {"name": "R7 up among agent tasks is one step; the tasks above it become the person's",
     "ranking": [["t-1", "queued", "agent"], ["t-2", "queued", "agent"], ["t-3", "queued", "agent"], ["t-4", "queued", "agent"]],
     "order": [], "last": [], "section": "queued", "task": "t-3", "move": "up",
     "expect": {"order": ["t-1", "t-3", "t-2"], "last": []}},
    {"name": "R7 up skips tasks of other states and hidden ranks; they keep their places",
     "ranking": [["t-1", "queued", "agent"], ["t-2", "in-progress", "agent"], ["t-3", "needs-decision", "agent"], ["t-4", "queued", "agent"]],
     "order": [], "last": [], "section": "queued", "task": "t-4", "move": "up",
     "expect": {"order": ["t-4", "t-2", "t-3", "t-1"], "last": []}},
    {"name": "R7 down swaps with the next task of the section; order runs down to the lower place",
     "ranking": [["t-1", "queued", "person"], ["t-2", "queued", "person"], ["t-3", "queued", "agent"], ["t-4", "queued", "agent"]],
     "order": ["t-1", "t-2"], "last": [], "section": "queued", "task": "t-1", "move": "down",
     "expect": {"order": ["t-2", "t-1"], "last": []}},
    {"name": "R7 down keeps the person's ids below the swap where they were",
     "ranking": [["t-1", "queued", "person"], ["t-2", "queued", "person"], ["t-3", "queued", "person"], ["t-4", "queued", "agent"]],
     "order": ["t-1", "t-2", "t-3"], "last": [], "section": "queued", "task": "t-1", "move": "down",
     "expect": {"order": ["t-2", "t-1", "t-3"], "last": []}},
    {"name": "R7 top goes directly above the first task of its section",
     "ranking": [["t-1", "review", "agent"], ["t-2", "queued", "agent"], ["t-3", "queued", "agent"], ["t-4", "queued", "agent"]],
     "order": [], "last": [], "section": "queued", "task": "t-4", "move": "top",
     "expect": {"order": ["t-1", "t-4"], "last": []}},
    {"name": "R7 bottom leaves order and goes to the end of last",
     "ranking": [["t-1", "queued", "person"], ["t-2", "queued", "person"], ["t-3", "queued", "agent"], ["t-5", "queued", "person"]],
     "order": ["t-1", "t-2"], "last": ["t-5"], "section": "queued", "task": "t-1", "move": "bottom",
     "expect": {"order": ["t-2"], "last": ["t-5", "t-1"]}},
    {"name": "R7 a swap that reaches into last writes the ranking down to it and keeps the last ids below it",
     "ranking": [["t-1", "queued", "agent"], ["t-2", "queued", "agent"], ["t-3", "queued", "person"], ["t-4", "queued", "person"]],
     "order": [], "last": ["t-3", "t-4"], "section": "queued", "task": "t-3", "move": "up",
     "expect": {"order": ["t-1", "t-3", "t-2"], "last": ["t-4"]}},
    {"name": "R12 chat tasks are written into order by the next write (bottom)",
     "ranking": [["t-9", "queued", "chat"], ["t-1", "queued", "person"], ["t-2", "queued", "agent"]],
     "order": ["t-1"], "last": [], "section": "queued", "task": "t-1", "move": "bottom",
     "expect": {"order": ["t-9"], "last": ["t-1"]}},
    {"name": "R12 chat tasks are written into order by the next write (top of a chat task)",
     "ranking": [["t-8", "queued", "chat"], ["t-9", "queued", "chat"], ["t-7", "queued", "chat"], ["t-1", "queued", "agent"]],
     "order": [], "last": [], "section": "queued", "task": "t-9", "move": "top",
     "expect": {"order": ["t-9", "t-8", "t-7"], "last": []}},
    {"name": "ids in order that are not in the ranking stay (the panel prunes them, R4)",
     "ranking": [["t-1", "queued", "person"], ["t-2", "queued", "agent"]],
     "order": ["t-1", "gone"], "last": [], "section": "queued", "task": "t-2", "move": "up",
     "expect": {"order": ["t-2", "t-1", "gone"], "last": []}},
    {"name": "no-op: up on the first task of its section",
     "ranking": [["t-1", "review", "agent"], ["t-2", "queued", "agent"], ["t-3", "queued", "agent"]],
     "order": [], "last": [], "section": "queued", "task": "t-2", "move": "up", "expect": null},
    {"name": "no-op: top on the first task of its section",
     "ranking": [["t-1", "review", "agent"], ["t-2", "queued", "agent"], ["t-3", "queued", "agent"]],
     "order": [], "last": [], "section": "queued", "task": "t-2", "move": "top", "expect": null},
    {"name": "no-op: down on the last task of its section",
     "ranking": [["t-1", "queued", "agent"], ["t-2", "queued", "agent"], ["t-3", "review", "agent"]],
     "order": [], "last": [], "section": "queued", "task": "t-2", "move": "down", "expect": null},
    {"name": "no-op: bottom on the last task of its section",
     "ranking": [["t-1", "queued", "agent"], ["t-2", "queued", "agent"], ["t-3", "review", "agent"]],
     "order": [], "last": [], "section": "queued", "task": "t-2", "move": "bottom", "expect": null},
    {"name": "no-op: a hidden-rank task",
     "ranking": [["t-1", "needs-decision", "agent"], ["t-2", "needs-decision", "agent"]],
     "order": [], "last": [], "section": "needs-decision", "task": "t-2", "move": "up", "expect": null},
    {"name": "no-op: a parked task",
     "ranking": [["t-1", "parked", "agent"], ["t-2", "parked", "agent"]],
     "order": [], "last": [], "section": "parked", "task": "t-1", "move": "down", "expect": null},
    {"name": "no-op: a task not in the ranking",
     "ranking": [["t-1", "queued", "agent"], ["t-2", "queued", "agent"]],
     "order": [], "last": [], "section": "queued", "task": "t-9", "move": "up", "expect": null},
    {"name": "no-op: a task of another section",
     "ranking": [["t-1", "queued", "agent"], ["t-2", "queued", "agent"]],
     "order": [], "last": [], "section": "review", "task": "t-2", "move": "up", "expect": null}
  ]
}
